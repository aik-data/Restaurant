---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { asset } from "@/lib/utils";
---
<Layout page="notfound" title="Page not found | Perfetto Italian Restaurant" description="This page doesn't exist. Find the menu, catering and private events at Perfetto Italian Restaurant in Downtown Tehachapi.">
  <section class="surface-paper grid min-h-[78vh] place-items-center pt-(--header-h) text-center">
    <div class="container-site py-24">
      <p class="eyebrow mb-6">Page not found</p>
      <h1 class="display-1 mb-6">We couldn't find <em>that page.</em></h1>
      <p class="lede mx-auto mb-9">It may have moved. The menu, catering and private events are one click away.</p>
      <div class="flex flex-wrap justify-center gap-3.5">
        <a href={asset("")} class={buttonVariants({ variant: "dark" })}>Back to home</a>
        <a href={asset("order.html")} class={buttonVariants({ variant: "outline" })}>Order catering</a>
      </div>
    </div>
  </section>
</Layout>
