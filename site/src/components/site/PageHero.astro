---
import type { Pic } from "@/lib/images";

interface Props {
  photo: Pic;
  back: { href: string; label: string };
  lede: string;
}
const { photo, back, lede } = Astro.props;
---
<section class="relative overflow-hidden bg-night pt-(--header-h) text-cream">
  <div class="absolute inset-0">
    <img src={photo.src} srcset={photo.srcset} sizes="100vw" alt="" fetchpriority="high" decoding="async" class="size-full animate-settle object-cover" />
  </div>
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(10_8_6/.92)_0%,rgb(10_8_6/.62)_55%,rgb(10_8_6/.4)_100%)]"></div>
  <div class="container-site relative z-[2] pt-[clamp(50px,7vw,100px)] pb-[clamp(46px,6vw,80px)]">
    <a href={back.href} class="inline-flex gap-2 text-[0.8rem] font-medium tracking-[0.18em] text-gold-2 uppercase no-underline transition-colors hover:text-cream">
      <span aria-hidden="true">←</span> {back.label}
    </a>
    <h1 class="mt-3 mb-2 max-w-[14ch] animate-rise text-[clamp(2.8rem,6.4vw,5.6rem)] [&_em]:text-gold-2"><slot name="title" /></h1>
    <p class="mb-7 max-w-[40rem] animate-rise text-[1.1rem] text-cream/85 [animation-delay:.1s]">{lede}</p>
    <div class="animate-rise [animation-delay:.2s]"><slot /></div>
  </div>
</section>
